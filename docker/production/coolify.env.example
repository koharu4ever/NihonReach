# Fill these values in Coolify. Do not commit a populated copy.
# APP_KEY / DB_PASSWORD are Runtime only; disable Build Variable for both.
APP_NAME=NihonReach
APP_ENV=production
APP_DEBUG=false
APP_URL=https://nihonreach.example.com
APP_KEY=
APP_LOCALE=zh
APP_FALLBACK_LOCALE=ja

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=nihonreach
DB_USERNAME=nihonreach
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# No outgoing mail in this demo. Use the operator command for password recovery.
MAIL_MAILER=array
MAIL_FROM_ADDRESS=demo@example.invalid
MAIL_FROM_NAME=NihonReach

# Comma-separated proxy IPs/CIDRs from the actual Coolify Docker network.
# Do not use * and do not publish the app's port directly on the VPS.
TRUSTED_PROXIES=
